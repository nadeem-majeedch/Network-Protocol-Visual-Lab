    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.11",
